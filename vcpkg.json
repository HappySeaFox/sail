{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "sail",
  "homepage": "https://github.com/HappySeaFox/sail",
  "dependencies": [
    {
      "name": "ffmpeg",
      "features": [
        "avcodec",
        "avformat",
        "swscale",
        "swresample",
        "bzip2",
        "lzma",
        "zlib"
      ]
    },
    {
      "name": "pkgconf",
      "host": true
    },
    "giflib",
    "jbigkit",
    {
      "name": "libavif",
      "features": [
        "aom"
      ]
    },
    "libheif",
    "libjpeg-turbo",
    "libjxl",
    "libpng",
    "libraw",
    "libwebp",
    "nanosvg",
    "openexr",
    "openjpeg",
    "tiff",
    "zlib"
  ],
  "builtin-baseline": "04a9d8e5212d01ee1dd9478eadd9caade4f8b0d4"
}
